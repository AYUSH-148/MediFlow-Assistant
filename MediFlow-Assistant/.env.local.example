# REQUIRED
GEMINI_API_KEY=your_gemini_api_key
HF_TOKEN=your_huggingface_token

# Index "medic", dimension 1024, cosine metric.
PINECONE_API_KEY=your_pinecone_api_key

# Backs both the semantic response cache and the PII token vault.
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# NEO4J (graph features are skipped when these are absent)
NEO4J_URI=your_neo4j_uri
NEO4J_USER=your_neo4j_user
NEO4J_PASSWORD=your_neo4j_password

# LANGSMITH OBSERVABILITY (optional - tracing is off unless both of the first two are set)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
# Region-specific. Omit for US; use https://apac.api.smith.langchain.com for APAC,
# https://eu.api.smith.langchain.com for EU.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=your_project_name

# Records raw pre-redaction / post-rehydration text in traces (OCR transcription, the
# token vault, the raw user question, the re-identified answer). LEAVE UNSET unless
# sending that data to LangSmith is acceptable for your deployment - with it off,
# boundary spans still record latency, errors, and counts, just not the text.
# LANGSMITH_TRACE_PHI=true
